+
+    # shape: (n_test, n_prefix, num_mc, L)
+    pred_mem = np.lib.format.open_memmap(
+        pred_path,  mode="w+", dtype=np.float32,
+        shape=(n_test, n_prefix, args.num_mc, length),
+    )
+    target_mem = np.lib.format.open_memmap(
